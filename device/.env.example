# Скопируйте в .env и заполните. Файл .env не коммитим.

# virtual — виртуальное железо на любом ПК, hardware — настоящая Raspberry Pi
RUNTIME=virtual

# Ключ для заголовка X-API-Key. Сгенерировать: python -m lighting.runtime.gen_key
# Пустое значение отключает проверку (только для разработки).
API_KEY=

DEVICE_NAME=LightningSystem
